<!-- Test.Bff.Presentation — ASP.NET Core Web API (BFF-API archetype) -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Test.Bff.Presentation</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Onion: Presentation depends on Application + Infrastructure -->
    <ProjectReference Include="../Test.Bff.Application/Test.Bff.Application.csproj" />
    <ProjectReference Include="../Test.Bff.Infrastructure/Test.Bff.Infrastructure.csproj" />
    <ProjectReference Include="../Test.Bff.Common/Test.Bff.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.*" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.*" />
    <!-- BFF handles auth/claims for frontend -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.*" />
  </ItemGroup>

</Project>
