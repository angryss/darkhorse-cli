<!-- Test.Bff.Application — CQRS handlers: queries → APIs, commands → broker (BFF-API archetype) -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Test.Bff.Application</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Onion: Application depends on Domain only -->
    <ProjectReference Include="../Test.Bff.Domain/Test.Bff.Domain.csproj" />
    <ProjectReference Include="../Test.Bff.Common/Test.Bff.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.4.*" />
    <PackageReference Include="FluentValidation" Version="11.9.*" />
    <PackageReference Include="AutoMapper" Version="13.0.*" />
    <!-- NOTE: No persistence packages. BFF does NOT own data. -->
  </ItemGroup>

</Project>
