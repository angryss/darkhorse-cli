<!-- MyCompany.Orders.Presentation — ASP.NET Core Web API (API archetype) -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MyCompany.Orders.Presentation</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Onion: Presentation depends on Application + Infrastructure -->
    <ProjectReference Include="../MyCompany.Orders.Application/MyCompany.Orders.Application.csproj" />
    <ProjectReference Include="../MyCompany.Orders.Infrastructure/MyCompany.Orders.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Common contracts/utilities (external NuGet package) -->
    <PackageReference Include="MyCompany.Orders.Common" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.*" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.*" />
  </ItemGroup>

</Project>
