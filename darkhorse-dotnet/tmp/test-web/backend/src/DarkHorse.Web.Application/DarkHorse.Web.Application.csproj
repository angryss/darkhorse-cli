<!-- DarkHorse.Web.Application — CQRS handlers: queries → APIs, commands → broker (BFF-API archetype) -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DarkHorse.Web.Application</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Onion: Application depends on Domain only -->
    <ProjectReference Include="../DarkHorse.Web.Domain/DarkHorse.Web.Domain.csproj" />
    <ProjectReference Include="../DarkHorse.Web.Common/DarkHorse.Web.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.4.*" />
    <PackageReference Include="FluentValidation" Version="11.9.*" />
    <PackageReference Include="AutoMapper" Version="13.0.*" />
    <!-- NOTE: No persistence packages. BFF does NOT own data. -->
  </ItemGroup>

</Project>
