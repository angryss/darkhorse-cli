<!-- TestApi.Infrastructure — Persistence, messaging (API archetype) -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TestApi.Infrastructure</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Onion: Infrastructure depends on Application + Domain -->
    <ProjectReference Include="../TestApi.Application/TestApi.Application.csproj" />
    <ProjectReference Include="../TestApi.Domain/TestApi.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Common contracts/utilities (external NuGet package) -->
    <PackageReference Include="TestApi.Common" Version="1.0.*" />

  <ItemGroup>
    <!-- Persistence (API archetype owns its data) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
