{
  "name": "react-toolkit",
  "version": "1.0.0",
  "private": true,
  "description": "Advanced React component library for complex UI patterns",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r --parallel run test:watch",
    "test:coverage": "pnpm -r run test:coverage",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "pnpm -r run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^7.6.4",
    "@storybook/addon-actions": "^7.6.4",
    "@storybook/addon-essentials": "^7.6.4",
    "@storybook/addon-links": "^7.6.4",
    "@storybook/react": "^7.6.4",
    "@storybook/react-vite": "^7.6.4",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.1.0",
    "axe-core": "^4.8.3",
    "eslint": "^8.56.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^23.0.1",
    "rimraf": "^5.0.5",
    "storybook": "^7.6.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "author": "Angry Software Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angryss/darkhorse-cli.git",
    "directory": "darkhorse-dotnet/toolkit"
  },
  "bugs": {
    "url": "https://github.com/angryss/darkhorse-cli/issues"
  },
  "homepage": "https://angryss.com",
  "keywords": [
    "darkhorse",
    "react",
    "components"
  ],
  "license": "MIT"
}
