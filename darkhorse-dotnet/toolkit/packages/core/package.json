{
  "name": "@react-toolkit/core",
  "version": "1.0.0",
  "description": "Core utilities and types for React Toolkit components",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist *.tsbuildinfo",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "typescript",
    "utilities",
    "core",
    "darkhorse",
    "components"
  ],
  "author": "Angry Software Solutions",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dependencies": {
    "@react-toolkit/design-tokens": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angryss/darkhorse-cli.git",
    "directory": "darkhorse-dotnet/toolkit/packages/core"
  },
  "bugs": {
    "url": "https://github.com/angryss/darkhorse-cli/issues"
  },
  "homepage": "https://angryss.com"
}
