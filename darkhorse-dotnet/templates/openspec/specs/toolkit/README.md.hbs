## Usage

```tsx
// Routing
import { BrowserRouter, Route, Routes } from 'react-router-dom';

// State
import { create } from 'zustand';

// Chakra UI components
import { Button, Box, Text, Input } from '@chakra-ui/react';

// Tailwind (add classes directly)
<div className="flex items-center gap-4 p-4 bg-gray-50">

// Toolkit
import { KanbanBoard } from '@react-toolkit/kanban';
import { tokens } from '@react-toolkit/design-tokens';

// Forms with Zod schema validation
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';

const schema = z.object({ email: z.string().email(), age: z.number().min(18) });
type FormData = z.infer<typeof schema>;

const { register, handleSubmit, formState: { errors } } = useForm<FormData>({ resolver: zodResolver(schema) });
```

## Rules

- **Use Chakra UI** for standard UI elements (buttons, inputs, modals, forms, layout)
- **Use Tailwind** for custom spacing, responsive layouts, and utility classes
- **Use Zustand** for all global/shared state — avoid prop drilling or Context for cross-component state
- **Use react-hook-form + Zod** for ALL forms and any input that requires schema validation — define the Zod schema first, derive the TypeScript type with `z.infer<>`, then wire to `useForm` via `zodResolver`
- **Use Toolkit** for complex domain widgets (Kanban, Gantt, charts, scheduler) — do NOT rebuild these
- Toolkit packages are **FROZEN** — zero modifications allowed
- Check toolkit components **before** building any custom complex widget
- Do NOT mix multiple state management approaches (no Redux, no MobX, no Jotai)
