# {{project.name}} — Docker Compose

services:
  backend:
    build:
      context: ../backend/{{archetypeCategory}}
      dockerfile: Dockerfile
    ports:
      - "5000:8080"
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:8080
    networks:
      - app-network

  # Uncomment as needed:
  # postgres:
  #   image: postgres:16-alpine
  #   ports:
  #     - "5432:5432"
  #   environment:
  #     POSTGRES_DB: {{project.name}}
  #     POSTGRES_USER: app
  #     POSTGRES_PASSWORD: changeme
  #   volumes:
  #     - postgres-data:/var/lib/postgresql/data
  #   networks:
  #     - app-network

{{#if project.features.frontend}}
{{#if (eq project.frontend.platform "web")}}
  frontend:
    build:
      context: ../frontend/web-app
    ports:
      - "3000:3000"
    environment:
      VITE_API_URL: http://localhost:5000
    depends_on:
      - backend
    networks:
      - app-network
{{/if}}
{{/if}}

networks:
  app-network:
    driver: bridge

