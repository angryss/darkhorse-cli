<!-- {{project.dotnet.namespace}}.Presentation — Message listeners, health endpoints (Microservice archetype) -->
<!-- Microservice is NOT HTTP-first. Presentation = message listeners + optional health. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net{{project.dotnet.dotnetVersion}}.0</TargetFramework>
    <RootNamespace>{{project.dotnet.namespace}}.Presentation</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../{{project.dotnet.namespace}}.Application/{{project.dotnet.namespace}}.Application.csproj" />
    <ProjectReference Include="../{{project.dotnet.namespace}}.Infrastructure/{{project.dotnet.namespace}}.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Health checks only — microservice is not HTTP-first -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="8.0.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.*" />
    <!-- NOTE: No Swagger/OpenAPI by default. Add only if exposing admin endpoints. -->
  </ItemGroup>

</Project>
