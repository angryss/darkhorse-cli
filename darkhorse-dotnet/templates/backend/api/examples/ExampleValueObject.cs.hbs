namespace {{project.dotnet.namespace}}.Domain.Examples;

/// <summary>
/// EXAMPLE: Value Object for a standard API archetype.
///
/// Value objects have no identity. They are equal if their values are equal.
/// They are IMMUTABLE — all properties are set at construction, no setters.
///
/// Use records for value objects in modern C# (structural equality is built in).
///
/// Location in a real context:
///   {Namespace}.Domain/Contexts/{Context}/ValueObjects/Money.cs
///
/// DELETE THIS FILE — replace with your real value objects.
/// </summary>
public record ExampleValueObject
{
    public decimal Amount { get; }
    public string Currency { get; }

    public ExampleValueObject(decimal amount, string currency)
    {
        if (amount < 0) throw new ArgumentOutOfRangeException(nameof(amount), "Amount cannot be negative.");
        ArgumentException.ThrowIfNullOrWhiteSpace(currency);

        Amount = amount;
        Currency = currency.ToUpperInvariant();
    }

    // ---- Domain operations — return new instances (immutable) ----

    public ExampleValueObject Add(ExampleValueObject other)
    {
        if (Currency != other.Currency)
            throw new InvalidOperationException($"Cannot add {Currency} and {other.Currency}.");

        return new ExampleValueObject(Amount + other.Amount, Currency);
    }

    public override string ToString() => $"{Amount:F2} {Currency}";

    // ---- Implicit zero constant ----
    public static ExampleValueObject Zero(string currency) => new(0, currency);
}
