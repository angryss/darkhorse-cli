<!-- {{project.dotnet.namespace}}.Infrastructure — REST clients, message senders (BFF-API archetype) -->
<!-- NOTE: No persistence dependencies. BFF does NOT own data. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net{{project.dotnet.dotnetVersion}}.0</TargetFramework>
    <RootNamespace>{{project.dotnet.namespace}}.Infrastructure</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Onion: Infrastructure depends on Application + Domain -->
    <ProjectReference Include="../{{project.dotnet.namespace}}.Application/{{project.dotnet.namespace}}.Application.csproj" />
    <ProjectReference Include="../{{project.dotnet.namespace}}.Domain/{{project.dotnet.namespace}}.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Workspace-shared contracts (integration events, shared abstractions) -->
    <ProjectReference Include="../../../../shared/{{project.workspaceNamespace}}.Contracts/{{project.workspaceNamespace}}.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- REST Client (calls downstream APIs) -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="{{project.dotnet.dotnetVersion}}.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="{{project.dotnet.dotnetVersion}}.0.*" />

    <!-- Messaging (commands dispatched to broker) -->
    <PackageReference Include="MassTransit" Version="8.2.*" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.2.*" />

    <!-- NOTE: No EF Core. No database drivers. BFF does NOT persist. -->
  </ItemGroup>

</Project>
