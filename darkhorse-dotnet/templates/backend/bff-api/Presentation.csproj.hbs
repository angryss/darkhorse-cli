<!-- {{project.dotnet.namespace}}.Presentation — ASP.NET Core Web API (BFF-API archetype) -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net{{project.dotnet.dotnetVersion}}.0</TargetFramework>
    <RootNamespace>{{project.dotnet.namespace}}.Presentation</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Onion: Presentation depends on Application + Infrastructure -->
    <ProjectReference Include="../{{project.dotnet.namespace}}.Application/{{project.dotnet.namespace}}.Application.csproj" />
    <ProjectReference Include="../{{project.dotnet.namespace}}.Infrastructure/{{project.dotnet.namespace}}.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.*" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.*" />
    <!-- BFF handles auth/claims for frontend -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="{{project.dotnet.dotnetVersion}}.0.*" />
  </ItemGroup>

</Project>
