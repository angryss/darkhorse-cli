{
  "inputs": [
    {
      "id": "ado_org",
      "type": "promptString",
      "description": "Azure DevOps organization name (e.g. 'contoso') — remove this server if using Jira instead"
    },
    {
      "id": "google_client_id",
      "type": "promptString",
      "description": "Google OAuth Client ID (from Google Cloud Console) — remove this server if not using Google Drive"
    },
    {
      "id": "google_client_secret",
      "type": "promptString",
      "description": "Google OAuth Client Secret (from Google Cloud Console)",
      "password": true
    }
  ],
  "servers": {
    "darkhorse": {
      "command": "npx",
      "args": ["darkhorse-dotnet", "mcp-serve"],
      "env": {}
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "azure-devops": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure-devops/mcp", "${input:ado_org}"]
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "google-drive": {
      "type": "stdio",
      "command": "uvx",
      "args": ["workspace-mcp", "--tools", "drive"],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${input:google_client_id}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${input:google_client_secret}"
      }
    }
  }
}
