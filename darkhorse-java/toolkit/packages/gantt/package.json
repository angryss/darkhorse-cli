{
  "name": "@react-toolkit/gantt",
  "version": "1.0.0",
  "description": "Gantt Chart component for React - Project timeline visualization",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc --emitDeclarationOnly",
    "dev": "tsc --watch",
    "clean": "rimraf dist"
  },
  "keywords": [
    "react",
    "gantt",
    "chart",
    "timeline",
    "project",
    "planning",
    "tasks"
  ],
  "author": "React Toolkit Team",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@react-toolkit/core": "workspace:*",
    "@react-toolkit/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.3"
  }
}

