<!-- {{project.dotnet.namespace}}.IntegrationTests — Infrastructure and end-to-end tests -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net{{project.dotnet.dotnetVersion}}.0</TargetFramework>
    <RootNamespace>{{project.dotnet.namespace}}.IntegrationTests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/{{project.dotnet.namespace}}.Application/{{project.dotnet.namespace}}.Application.csproj" />
    <ProjectReference Include="../../src/{{project.dotnet.namespace}}.Infrastructure/{{project.dotnet.namespace}}.Infrastructure.csproj" />
    <ProjectReference Include="../../src/{{project.dotnet.namespace}}.Common/{{project.dotnet.namespace}}.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
{{#if project.features.persistence}}
    <!-- SQLite in-memory for integration test isolation -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="{{project.dotnet.dotnetVersion}}.0.*" />
{{/if}}
  </ItemGroup>

</Project>
