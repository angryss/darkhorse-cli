using CommunityToolkit.Mvvm.ComponentModel;
using CommunityToolkit.Mvvm.Input;
using MediatR;
using {{project.dotnet.namespace}}.Application.Commands.Examples;
using {{project.dotnet.namespace}}.Application.Queries.Examples;
using {{project.dotnet.namespace}}.Common.Primitives;

namespace {{project.dotnet.namespace}}.Presentation.ViewModels.Examples;

/// <summary>
/// Example ViewModel — demonstrates MVVM + CQRS integration via MediatR.
/// The ViewModel dispatches commands and queries via IMediator. It has zero business logic.
/// Replace this with your actual ViewModels for each bounded context.
///
/// RULE: ViewModels depend on Application layer only (via IMediator).
/// RULE: ViewModels never reference Infrastructure or Domain directly.
/// </summary>
public partial class SampleItemsViewModel : ViewModelBase
{
    private readonly IMediator _mediator;

    [ObservableProperty]
    private IReadOnlyList<SampleItemDto> _items = [];

    [ObservableProperty]
    private string _newItemName = string.Empty;

    [ObservableProperty]
    private string _newItemDescription = string.Empty;

    public SampleItemsViewModel(IMediator mediator)
    {
        _mediator = mediator;
    }

    [RelayCommand]
    private async Task LoadItemsAsync()
    {
        try
        {
            IsBusy = true;
            ClearError();
            Items = await _mediator.Send(new GetSampleItemsQuery());
        }
        catch (Exception ex)
        {
            SetError($"Failed to load items: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    [RelayCommand(CanExecute = nameof(CanCreateItem))]
    private async Task CreateItemAsync()
    {
        try
        {
            IsBusy = true;
            ClearError();
            await _mediator.Send(new CreateSampleItemCommand(NewItemName, NewItemDescription));
            NewItemName = string.Empty;
            NewItemDescription = string.Empty;
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            SetError($"Failed to create item: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private bool CanCreateItem() =>
        !IsBusy &&
        !string.IsNullOrWhiteSpace(NewItemName) &&
        !string.IsNullOrWhiteSpace(NewItemDescription);
}
