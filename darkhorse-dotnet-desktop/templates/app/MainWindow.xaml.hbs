<Window x:Class="{{project.dotnet.namespace}}.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:{{project.dotnet.namespace}}.Presentation.ViewModels"
{{#if (eq project.dotnet.uiFramework "materialdesign")}}
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
{{else}}
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
{{/if}}
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        Title="{{project.name}}"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen"
        MinWidth="800"
        MinHeight="600">

    <Window.DataContext>
        <!-- DataContext is injected via constructor by the DI container -->
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar / Navigation -->
        <Border Grid.Row="0" Padding="16,12"
{{#if (eq project.dotnet.uiFramework "materialdesign")}}
                Background="{DynamicResource PrimaryHueMidBrush}">
            <TextBlock Text="{{project.name}}"
                       Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                       FontSize="20"
                       FontWeight="Medium"
                       Style="{DynamicResource MaterialDesignHeadline6TextBlock}" />
{{else}}
                Background="{DynamicResource ApplicationBackgroundBrush}">
            <ui:TitleBar Title="{{project.name}}" />
{{/if}}
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Side Navigation -->
            <Border Grid.Column="0" Margin="0,0,8,0"
{{#if (eq project.dotnet.uiFramework "materialdesign")}}
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    CornerRadius="4">
{{else}}
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
{{/if}}
                <StackPanel Margin="8">
                    <TextBlock Text="Navigation"
                               FontWeight="SemiBold"
                               Margin="8,8,8,12"
                               FontSize="13" />
                    <!-- TODO: Add navigation items for bounded contexts -->
                </StackPanel>
            </Border>

            <!-- Content Frame -->
            <Frame Grid.Column="1"
                   x:Name="MainFrame"
                   NavigationUIVisibility="Hidden" />
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2"
                   Padding="8,4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
