<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Semantic Color Tokens — use these throughout the app, not raw hex values.
        Override this file to rebrand the entire application in one place.
    -->

    <!-- Brand -->
    <Color x:Key="BrandPrimaryColor">#7E57C2</Color>
    <Color x:Key="BrandSecondaryColor">#00BCD4</Color>
    <Color x:Key="BrandAccentColor">#FF7043</Color>

    <!-- Surfaces -->
    <Color x:Key="SurfaceBackgroundColor">#1E1E2E</Color>
    <Color x:Key="SurfaceElevated1Color">#252535</Color>
    <Color x:Key="SurfaceElevated2Color">#2D2D40</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F4F4F7</Color>
    <Color x:Key="TextSecondaryColor">#B0B0C8</Color>
    <Color x:Key="TextDisabledColor">#707090</Color>

    <!-- Semantic State -->
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="WarningColor">#FF9800</Color>
    <Color x:Key="ErrorColor">#F44336</Color>
    <Color x:Key="InfoColor">#2196F3</Color>

    <!-- Borders -->
    <Color x:Key="BorderSubtleColor">#3A3A55</Color>
    <Color x:Key="BorderStrongColor">#6060A0</Color>

    <!-- SolidColorBrush equivalents -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource BrandSecondaryColor}" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackgroundColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />

</ResourceDictionary>
