# GitHub Actions — Build, Test & Package MSI Installer
# Generated by darkhorse-dotnet-desktop
#
# Triggers:
#   - Push to main (build + test only)
#   - Version tags v*.*.* (build + test + package MSI + upload artifact)
#
# Requirements:
#   - GitHub-hosted runner: windows-latest (needed for WPF + WiX)
#   - dotnet tool: wix (installed via dotnet tool restore)
#
# To enable PAT-based operations from the agent, set the following secrets:
#   GITHUB_TOKEN  — auto-provided, used for release uploads
#   (No extra secrets needed for standard CI use)

name: Build & Package

on:
  push:
    branches: [main]
    tags: ['v*.*.*']
  pull_request:
    branches: [main]

env:
  DOTNET_VERSION: '{{project.dotnet.dotnetVersion}}.0'
  DOTNET_NOLOGO: true
  DOTNET_SKIP_FIRST_TIME_EXPERIENCE: true
  CONFIGURATION: Release
  SOLUTION: {{project.dotnet.namespace}}.sln
  INSTALLER_PROJECT: deploy/installer/{{project.dotnet.namespace}}.Installer.wixproj

jobs:
  # -------------------------------------------------------------------------
  # build-and-test
  # -------------------------------------------------------------------------
  build-and-test:
    name: Build & Test
    runs-on: windows-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: ${{ '{{' }} env.DOTNET_VERSION {{ '}}' }}

      - name: Restore
        run: dotnet restore ${{ '{{' }} env.SOLUTION {{ '}}' }}

      - name: Build
        run: dotnet build ${{ '{{' }} env.SOLUTION {{ '}}' }} -c ${{ '{{' }} env.CONFIGURATION {{ '}}' }} --no-restore

      - name: Test
        run: dotnet test ${{ '{{' }} env.SOLUTION {{ '}}' }} -c ${{ '{{' }} env.CONFIGURATION {{ '}}' }} --no-build --verbosity normal

  # -------------------------------------------------------------------------
  # package-installer — only on version tags
  # -------------------------------------------------------------------------
  package-installer:
    name: Package MSI Installer
    runs-on: windows-latest
    needs: build-and-test
    if: startsWith(github.ref, 'refs/tags/v')

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: ${{ '{{' }} env.DOTNET_VERSION {{ '}}' }}

      - name: Install WiX 4 toolset
        run: dotnet tool install --global wix --version 4.0.*

      - name: Add WiX extensions
        run: |
          wix extension add WixToolset.UI.wixext/4.0.*
          wix extension add WixToolset.Util.wixext/4.0.*

      - name: Restore
        run: dotnet restore ${{ '{{' }} env.SOLUTION {{ '}}' }}

      - name: Publish app (self-contained, win-x64)
        run: |
          dotnet publish src/{{project.dotnet.namespace}}.Presentation/{{project.dotnet.namespace}}.Presentation.csproj `
            -c ${{ '{{' }} env.CONFIGURATION {{ '}}' }} `
            -r win-x64 `
            --self-contained true `
            -p:PublishSingleFile=false `
            -p:IncludeNativeLibrariesForSelfExtract=true

      - name: Inject version into Variables.wxi
        shell: pwsh
        run: |
          $tag = '${{ '{{' }} github.ref_name {{ '}}' }}'.TrimStart('v')
          $file = 'deploy/installer/Variables.wxi'
          (Get-Content $file) -replace '(?<=define ProductVersion\s*=\s*")[^"]+', $tag | Set-Content $file

      - name: Build MSI installer
        run: dotnet build ${{ '{{' }} env.INSTALLER_PROJECT {{ '}}' }} -c ${{ '{{' }} env.CONFIGURATION {{ '}}' }} -p:Platform=x64

      - name: Upload MSI artifact
        uses: actions/upload-artifact@v4
        with:
          name: installer-${{ '{{' }} github.ref_name {{ '}}' }}
          path: deploy/installer/bin/Release/**/*.msi
          if-no-files-found: error

      # Optional: attach MSI to GitHub Release
      - name: Upload MSI to GitHub Release
        if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          files: deploy/installer/bin/Release/**/*.msi
        env:
          GITHUB_TOKEN: ${{ '{{' }} secrets.GITHUB_TOKEN {{ '}}' }}
