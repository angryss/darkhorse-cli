# Azure DevOps Pipeline — Build, Test & Package MSI Installer
# Generated by darkhorse-dotnet-desktop
#
# Triggers:
#   - Push to main (build + test)
#   - Version tags v*.*.* (build + test + package MSI + publish artifact)
#
# To connect this pipeline:
#   1. Commit this file to your repository root.
#   2. In Azure DevOps: Pipelines → New Pipeline → Azure Repos Git → Existing YAML file.
#   3. Select azure-pipelines.yml and save.
#
# Agent requirements:
#   - windows-latest (needed for WPF + WiX)
#   - dotnet SDK {{project.dotnet.dotnetVersion}}.x pre-installed (or use UseDotNet task)
#
# To allow the agent to configure this pipeline via PAT:
#   Set variable group "darkhorse-cicd" with:
#     ADO_ORG_URL  = {{#if project.deployment.adoOrgUrl}}{{project.deployment.adoOrgUrl}}{{else}}https://dev.azure.com/YOUR_ORG{{/if}}
#     ADO_PAT      = <personal access token with pipeline:read, pipeline:write, code:read>

trigger:
  branches:
    include:
      - main
  tags:
    include:
      - 'v*.*.*'

pr:
  branches:
    include:
      - main

variables:
  dotnetVersion: '{{project.dotnet.dotnetVersion}}.0'
  buildConfiguration: 'Release'
  solution: '{{project.dotnet.namespace}}.sln'
  installerProject: 'deploy/installer/{{project.dotnet.namespace}}.Installer.wixproj'
  DOTNET_NOLOGO: true
  DOTNET_SKIP_FIRST_TIME_EXPERIENCE: true

pool:
  vmImage: 'windows-latest'

stages:
  # ---------------------------------------------------------------------------
  # Stage 1: Build & Test
  # ---------------------------------------------------------------------------
  - stage: BuildAndTest
    displayName: 'Build & Test'

    jobs:
      - job: Build
        displayName: 'Build and run tests'

        steps:
          - task: UseDotNet@2
            displayName: 'Use .NET $(dotnetVersion)'
            inputs:
              packageType: sdk
              version: $(dotnetVersion)

          - task: DotNetCoreCLI@2
            displayName: 'Restore'
            inputs:
              command: restore
              projects: $(solution)

          - task: DotNetCoreCLI@2
            displayName: 'Build'
            inputs:
              command: build
              projects: $(solution)
              arguments: '-c $(buildConfiguration) --no-restore'

          - task: DotNetCoreCLI@2
            displayName: 'Test'
            inputs:
              command: test
              projects: '**/*.UnitTests.csproj;**/*.IntegrationTests.csproj'
              arguments: '-c $(buildConfiguration) --no-build --verbosity normal'
              publishTestResults: true

  # ---------------------------------------------------------------------------
  # Stage 2: Package MSI — only on version tags
  # ---------------------------------------------------------------------------
  - stage: PackageInstaller
    displayName: 'Package MSI Installer'
    dependsOn: BuildAndTest
    condition: and(succeeded(), startsWith(variables['Build.SourceBranch'], 'refs/tags/v'))

    jobs:
      - job: Package
        displayName: 'Build WiX installer'

        steps:
          - task: UseDotNet@2
            displayName: 'Use .NET $(dotnetVersion)'
            inputs:
              packageType: sdk
              version: $(dotnetVersion)

          - script: dotnet tool install --global wix --version 4.0.*
            displayName: 'Install WiX 4 toolset'

          - script: |
              wix extension add WixToolset.UI.wixext/4.0.*
              wix extension add WixToolset.Util.wixext/4.0.*
            displayName: 'Add WiX extensions'

          - task: DotNetCoreCLI@2
            displayName: 'Restore'
            inputs:
              command: restore
              projects: $(solution)

          - task: DotNetCoreCLI@2
            displayName: 'Publish app (self-contained win-x64)'
            inputs:
              command: publish
              projects: 'src/{{project.dotnet.namespace}}.Presentation/{{project.dotnet.namespace}}.Presentation.csproj'
              arguments: >
                -c $(buildConfiguration)
                -r win-x64
                --self-contained true
                -p:PublishSingleFile=false

          - pwsh: |
              $tag = '$(Build.SourceBranchName)'.TrimStart('v')
              $file = 'deploy/installer/Variables.wxi'
              (Get-Content $file) -replace '(?<=define ProductVersion\s*=\s*")[^"]+', $tag | Set-Content $file
              Write-Host "Set ProductVersion to $tag"
            displayName: 'Inject version into Variables.wxi'

          - task: DotNetCoreCLI@2
            displayName: 'Build MSI installer'
            inputs:
              command: build
              projects: $(installerProject)
              arguments: '-c $(buildConfiguration) -p:Platform=x64'

          - task: PublishBuildArtifacts@1
            displayName: 'Publish MSI artifact'
            inputs:
              pathToPublish: 'deploy/installer/bin/Release'
              artifactName: 'installer-$(Build.SourceBranchName)'
              publishLocation: Container
